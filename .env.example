# Variables de entorno — Punilla Full
# En Railway se setean en el servicio (Variables). En local, copiar a .env (no se commitea).

# La inyecta Railway al agregar el plugin Postgres. En local se usa la de desarrollo por defecto.
DATABASE_URL=postgresql://punilla:punilla@localhost:5432/punilla_dev

# Secreto para firmar los códigos (HMAC). CAMBIAR por uno largo y aleatorio en producción.
CODE_SECRET=pon-aca-un-secreto-largo-y-aleatorio

# Clave del panel /admin (la que usa el cajero para entrar). CAMBIAR en producción.
ADMIN_KEY=pon-aca-la-clave-del-panel

# Número de WhatsApp Business del negocio, formato internacional sin +, con 549.
# Ej: 5493541XXXXXX
WA_NUMBER=5493541000000

# Railway lo setea solo.
# PORT=3000
