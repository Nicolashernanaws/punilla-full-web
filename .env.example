# Variables de entorno — Punilla Full
# En Railway se setean en el servicio (Variables). En local, copiar a .env (no se commitea).

# La inyecta Railway al agregar el plugin Postgres. En local se usa la de desarrollo por defecto.
DATABASE_URL=postgresql://punilla:punilla@localhost:5432/punilla_dev

# Secreto para firmar los códigos (HMAC). CAMBIAR por uno largo y aleatorio en producción.
CODE_SECRET=pon-aca-un-secreto-largo-y-aleatorio

# Clave del panel /admin (la que usa el cajero para entrar). CAMBIAR en producción.
ADMIN_KEY=pon-aca-la-clave-del-panel

# ── Parte Diario ─────────────────────────────────────────────────────────────
# El link directo al tablero: /parte/admin/t/<PARTE_ADMIN_TOKEN>. Se abre y entra,
# sin pedir nada, y deja la sesión 30 días.
#
# 🔴 QUIEN TIENE EL LINK, ENTRA: el tablero muestra los nombres de todos, la línea
# de tiempo entera y los montos de la caja. Va a favoritos, NO a un grupo. Se mata
# cambiando esta variable, sin tocar código y sin invalidar los PIN de la gente.
#
# Mínimo 32 caracteres: con menos, el link NO se habilita (un token corto en una
# URL no lo frena ningún contador de intentos). Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si no está seteada, el servicio imprime uno listo para pegar al arrancar.
PARTE_ADMIN_TOKEN=

# El PIN del tablero: el respaldo para entrar a mano si el token cambió o se
# perdió el favorito. 4 a 10 dígitos. Sin esto, sirve igual la ADMIN_KEY de arriba.
PARTE_ADMIN_PIN=

# Sólo para el link que se imprime al arrancar. Railway pone RAILWAY_PUBLIC_DOMAIN
# sola; esto es para el día que haya dominio propio.
# PARTE_BASE_URL=https://punillafull.com

# Número de WhatsApp Business del negocio, formato internacional sin +, con 549.
# Ej: 5493541XXXXXX
WA_NUMBER=5493541000000

# Railway lo setea solo.
# PORT=3000
